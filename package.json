{
  "name": "context-aware-enterprise-knowledge",
  "private": true,
  "description": "Assistente de conhecimento corporativo no SharePoint com respostas citadas e respeito a permissões.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "test-support",
    "apps/knowledge-api",
    "eval"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b && tsc -p apps/knowledge-api/tsconfig.contract.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "eval": "tsc -b && node eval/dist/cli.js",
    "eval:mock": "npm run eval -- --mock",
    "test:spfx": "node scripts/check-spfx-installed.mjs && npm --prefix apps/spfx-assistant run test:unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "samples:build": "npm run build:docx -w @kb/sample-docs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:spfx"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
