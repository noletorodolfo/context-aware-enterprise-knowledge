tenant_id         = "00000000-0000-0000-0000-000000000000"
subscription_id   = "00000000-0000-0000-0000-000000000000"
owner             = "your-github-username"
sharepoint_origin = "https://contoso.sharepoint.com"
search_site_urls = ["https://contoso.sharepoint.com/sites/kb-demo"]
operator_object_id = "00000000-0000-0000-0000-000000000000"
name_suffixes = {
  function_app = "abc123"
  openai       = "def456"
  key_vault    = "ghi789"
  search       = "jkl012"
  ingestion    = "mno345"
}
state_resource_group_name  = "rg-kb-tfstate"
state_storage_account_name = "stkbtfstatexxxxxx"
# After bootstrap creates the CI identities:
# ci_plan_principal_id  = "00000000-0000-0000-0000-000000000000"
# ci_apply_principal_id = "00000000-0000-0000-0000-000000000000"
alert_email = "you@example.com"
# Phase 7: the site the ingestion service watches, and the Entra groups allowed to read each library.
# Library names are matched ignoring accents and case, so plain ASCII is safe here: a non-ASCII value
# has to survive a secret, a shell and an app setting intact, and one hop reading it as a single-byte
# encoding silently stops a library from being indexed.
ingestion_site_url = "https://contoso.sharepoint.com/sites/kb-demo"
ingestion_library_acl = { "Politicas" = ["00000000-0000-0000-0000-000000000000"], "TI" = ["00000000-0000-0000-0000-000000000000"], "RH-Restrito" = ["00000000-0000-0000-0000-000000000000"] }
